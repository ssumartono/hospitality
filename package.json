{
  "name": "kost-hospitality",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "tsx watch src/server/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test tests/security.test.ts tests/inventory.domain.test.ts tests/pricing.domain.test.ts tests/allocation.domain.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/server/worker.ts",
    "test:integration": "tsx scripts/integration.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "storage:init": "tsx scripts/storage-init.ts",
    "test:e2e": "tsx scripts/prepare-e2e.ts && playwright test",
    "db:security-upgrade": "tsx scripts/migrate.ts && tsx scripts/encrypt-outbox.ts && tsx scripts/validate-security.ts",
    "db:development-plan": "tsx scripts/development-plan.ts --confirm-development",
    "db:seed-pilot": "tsx scripts/seed-pilot.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "file-type": "22.3.0",
    "lucide-react": "1.66.0",
    "nodemailer": "10.3.1",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
